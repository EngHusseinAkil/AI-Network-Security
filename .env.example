APP_ENV=production
SECRET_KEY=replace-with-secret-manager-value
DATABASE_URI=postgresql://replace-at-deployment
TRUSTED_HOSTS=security.example.com
TRUSTED_PROXY_HOPS=1
WEB_WORKER_COUNT=2
MIGRATION_STRICT=true
LOG_DESTINATION=stdout
CAPTURE_ENABLED=false
ALERT_NOTIFICATIONS_ENABLED=false
DEFENSIVE_ACTIONS_ENABLED=false
# Development-only demonstration mode. Production startup rejects this setting.
DEMO_MODE=false
